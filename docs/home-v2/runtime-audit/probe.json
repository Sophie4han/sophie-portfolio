      "time": 10907.8,
      "state": "crawling",
      "transform": "translate3d(887.704px, 194.354px, 0px)",
      "pose": "a",
      "stack": "function tick(now) {\n                    if (disposed || arrived) return;\n                    const elapsed = Math.min(now - origin, total);\n                    if (elapsed >= total) {\n                        settle();\n                        return;\n                    }\n                    // Continuous distance, rather than easing to a stop at every corner.\n                    let index = 0, remaining = distance * elapsed / total;\n                    while(index < lengths.length - 1 && remaining >= lengths[index])remaining -= lengths[index++];\n                    const from = route[index], to = route[index + 1];\n                    const progress = lengths[index] === 0 ? 1 : Math.min(1, Math.max(0, remaining / lengths[index]));\n                    node.dataset.segment = String(index + 1);\n                    node.dataset.direction = to.x < from.x ? \"left\" : to.x > from.x ? \"right\" : \"down\";\n                    node.dataset.pose = Math.floor(elapsed / 175) % 2 === 0 ? \"a\" : \"b\";\n                    node.style.transform = move({\n                        x: from.x + (to.x - from.x) * progress,\n                        y: from.y + (to.y - from.y) * progress\n                    });\n                    const phase = Math.sin(elapsed / 350 * Math.PI * 2);\n                    node.style.setProperty(\"--walk-bob\", `${(phase + 1) * .75}px`);\n                    node.style.setProperty(\"--walk-tilt\", `${phase * .5}deg`);\n                    node.style.setProperty(\"--walk-tail\", `${phase * 2}deg`);\n                    frame = requestAnimationFrame(tick);\n                }"
    },
